DARAJA_CONSUMER_KEY=replace-with-your-consumer-key
DARAJA_CONSUMER_SECRET=replace-with-your-consumer-secret
DARAJA_SHORTCODE=174379
DARAJA_PASSKEY=replace-with-your-sandbox-passkey
DARAJA_ENV=sandbox
DARAJA_CALLBACK_URL=https://your-public-host.example
DARAJA_VERIFY_STUB=true
DARAJA_INITIATOR_NAME=testapi
DARAJA_INITIATOR_PASSWORD=replace-with-your-initiator-password
DARAJA_CERT_PATH=certs/sandbox_public_key.pem
THIBITIFARE_DATABASE_PATH=data/thibitifare.sqlite3
THIBITIFARE_PHONE_ENCRYPTION_KEY=replace-with-url-safe-base64-encoded-32-byte-key
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_API_KEY=your-firebase-web-api-key
FIREBASE_AUTH_DOMAIN=your-firebase-project-id.firebaseapp.com
FIREBASE_APP_ID=your-firebase-web-app-id
# Optional server-only JSON service account. Prefer GOOGLE_APPLICATION_CREDENTIALS
# pointing to a protected file where your deployment supports secret files.
FIREBASE_SERVICE_ACCOUNT_JSON=
FRONTEND_ORIGINS=https://your-frontend.example
